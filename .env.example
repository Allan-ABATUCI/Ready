# Copy to .env.local for local development, or to .env for `docker compose up`.
# Never commit real values (both files are gitignored and excluded from the Docker image).
# None of these are ever exposed to the browser (no NEXT_PUBLIC_ prefix).

# Vercel Edge Config connection string (read-mostly flags + rule-pack versions).
# Optional locally: when unset, /api/rule-packs/manifest serves the bundled default manifest.
EDGE_CONFIG=

# Stripe webhook signing secret (whsec_...). Required for /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=
